{
  "name": "@patorbit/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules dist"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@patorbit/config": "workspace:*",
    "@patorbit/database": "workspace:*",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@patorbit/eslint-config": "workspace:*",
    "@patorbit/tsconfig": "workspace:*",
    "@types/express": "^4.17.0",
    "@types/node": "^20.14.0",
    "eslint": "^8.57.0",
    "source-map-support": "^0.5.21",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
