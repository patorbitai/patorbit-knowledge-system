    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@patorbit/database": "workspace:*",
    "@patorbit/types": "workspace:*",
    "stripe": "^16.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@patorbit/tsconfig": "workspace:*",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
