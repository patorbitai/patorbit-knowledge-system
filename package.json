{
  "name": "patorbit-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "prepare": "husky",
    "db:generate": "pnpm --filter @patorbit/database db:generate",
    "db:migrate": "pnpm --filter @patorbit/database db:migrate",
    "db:push": "pnpm --filter @patorbit/database db:push",
    "db:studio": "pnpm --filter @patorbit/database db:studio"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^3.3.3",
    "turbo": "^2.0.9",
    "typescript": "~5.5.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
