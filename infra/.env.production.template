# ── Patorbit Beta Production Environment Template ──
# Do NOT commit secrets to version control.
# Save as .env.production on the server.

# ── Node ──
NODE_ENV=production
LOG_LEVEL=info

# ── API ──
API_PORT=4000
FRONTEND_URL=https://beta.patorbit.com

# ── Database ──
POSTGRES_USER=patorbit
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=patorbit
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ── Redis ──
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ── Storage (MinIO) ──
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_BUCKET=patorbit

# ── Auth ──
JWT_ACCESS_SECRET=<generate: openssl rand -hex 64>
JWT_REFRESH_SECRET=<generate: openssl rand -hex 64>
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d
AUTH_URL=https://beta.patorbit.com

# ── AI ──
CLAUDE_API_KEY=

# ── Optional: Virus Scanning ──
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
