# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/patorbit"

# ─── NextAuth ────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"

# ─── OAuth (optional) ────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── AI Provider ─────────────────────────────────────────────
GEMINI_API_KEY=""

# ─── Razorpay ────────────────────────────────────────────────
# Get these from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."

# Create a webhook endpoint at https://dashboard.razorpay.com → Settings → Webhooks
# URL: https://your-domain.com/api/razorpay/webhook
# Events: subscription.authenticated, subscription.activated, subscription.charged,
#         subscription.cancelled, subscription.completed, subscription.expired,
#         subscription.paused, subscription.resumed
RAZORPAY_WEBHOOK_SECRET=""

# Create plans at https://dashboard.razorpay.com → Subscriptions → Plans
# The monthly Professional plan (₹149/month INR)
RAZORPAY_PLAN_PROFESSIONAL_MONTHLY="plan_..."

# Optional: yearly plan (not yet offered)
# RAZORPAY_PLAN_PROFESSIONAL_YEARLY=""
