# ── Patorbit Staging Environment ─────────────────────────────────────────
# Copy this to .env on your staging server and fill in real values

# Node
NODE_ENV=production
LOG_LEVEL=info

# API
API_PORT=4000
API_PREFIX=api

# Frontend URLs (for CORS & auth redirects)
FRONTEND_URL=https://patorbit-staging.vercel.app
ADMIN_URL=https://patorbit-admin-staging.vercel.app

# Database
DATABASE_URL=postgresql://patorbit:CHANGE_ME@staging-db.internal:5432/patorbit

# Redis (optional — falls back to in-memory if not set)
REDIS_URL=redis://:CHANGE_ME@staging-redis.internal:6379

# Auth
AUTH_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
AUTH_URL=https://patorbit-api-staging.onrender.com
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3-compatible Storage (optional — falls back to local disk)
STORAGE_ENDPOINT=https://s3.amazonaws.com
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_BUCKET=patorbit-staging

# Stripe (for billing — only needed if billing is used)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_PRO=price_...
# STRIPE_PRICE_ID_ENTERPRISE=price_...

# Opensearch / Search (optional — falls back to noop)
# OPENSEARCH_URL=https://search-staging.region.es.amazonaws.com

# Neo4j / Graph DB (optional — falls back to noop)
# NEO4J_URI=bolt://staging-neo4j.internal:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=CHANGE_ME

# Email (optional — uses console transport by default)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=CHANGE_ME
EMAIL_FROM=patorbit@staging.example.com

# Monitoring & Logging
SENTRY_DSN=
LOG_LEVEL=info
