# Ignore project-level build artifacts and dependencies
/node_modules
/.turbo
/dist
/.next

# Ignore app/package-level build artifacts and dependencies
**/node_modules
**/.turbo
**/dist
**/.next

# Ignore git and other VC
.git
.github
.gitignore

# Ignore local configs and logs
.env
.env*.local
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore test and config files not needed in production
**/tests/
**/__tests__/
**/*.spec.ts
**/*.test.ts
**/vitest.config.ts
**/jest.config.ts
**/playwright.config.ts
**/cypress/

# Editor and OS files
.vscode
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
.DS_Store
