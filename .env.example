# Patorbit Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit real secrets to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ── Authentication ────────────────────────────────────────────────────────────
AUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── AI Provider ───────────────────────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"
# GEMINI_MODEL="gemini-2.0-flash"
# AI_PROVIDER="gemini"

# ── Email (Resend) ────────────────────────────────────────────────────────────
# RESEND_API_KEY="re_your_key"
# EMAIL_FROM="Patorbit <noreply@patorbit.com>"

# ── Razorpay ──────────────────────────────────────────────────────────────────
# RAZORPAY_KEY_ID="rzp_test_your_key_id"
# RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
# RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
# RAZORPAY_PLAN_PROFESSIONAL_MONTHLY="plan_your_plan_id"
# RAZORPAY_PLAN_PROFESSIONAL_YEARLY=""
# NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# ── OAuth (optional) ──────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# ── LinkedIn (optional) ───────────────────────────────────────────────────────
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""
# LINKEDIN_REDIRECT_URI=""

# ── Features ──────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_RESUME_SERVER_SYNC="true"
# IMPORT_AI_FALLBACK="true"
# STORAGE_DIR="./uploads/evidence"
